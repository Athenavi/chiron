# ═══════════════════════════════════════════════════════════════════════════
# Chiron V3.0 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# 本文件仅需配置一个部署级主密钥：APP_SECRET。
#  —— 业务/基础设施配置（PostgreSQL、Redis、CORS、存储、模型、支付、
#      限流等）已全部迁移至后台「系统设置」维护，经 system_settings 表持久化，
#      敏感值（LLM/S3/支付密钥、redis/pg 密码等）使用 APP_SECRET 派生密钥做
#      AES-256-GCM 加密后落库，可在后台统一修改，便于切换 Redis 集群/数据库集群。
# ═══════════════════════════════════════════════════════════════════════════

# ── APP_SECRET（必须）────────────────────────────────────────────────────
# 部署级主密钥：≥32 字符，随机唯一。
# 生成：python scripts/init.py            （交互式：生成密钥 + 写 .env + 自检依赖 + 迁移）
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
# 用途：
#   1) 派生 JWT_SECRET / INTERNAL_TOKEN（未显式设置时）
#   2) 加密 system_settings 中的敏感配置（LLM/S3/支付密钥、redis/pg 密码）
#   3) 凭据加密密钥的回退来源（见下方 ENT_OIDC_SECRET_KEY）
# 警告：丢失 APP_SECRET 将导致无法解密已加密的后台配置，请妥善保管。
APP_SECRET=your-32-plus-char-random-secret-generate-with-secrets-token-urlsafe
CHIRON_DATA_DIR=~/.chiron

# ── 凭据加密专用密钥（可选）──────────────────────────────────────────────
# 用于加密 SSO / 短信 / 验证码 / 邮件 的凭据（ent_oidc_providers.client_secret_enc、
# ent_sms_config.secret_enc、ent_mail_config.smtp_password_enc / api_key_enc 等）。
# 留空时自动回退到 APP_SECRET 派生，因此**默认无需设置**；
# 需要与主密钥分离管理（例如轮换主密钥而不动凭据）时再显式设置（≥8 字符）。
# ⚠️ 密文与派生来源强绑定：设置/取消该变量后，此前保存的凭据将无法解密，
#    需要在对应后台页面重新填写一次。
#ENT_OIDC_SECRET_KEY=

# ── 多实例 / docker compose 部署（批 A）────────────────────────────────────
# 下方变量仅供 `docker compose up -d --scale gateway=N --scale python-engine=M` 使用;
# 裸机(run.py)启动由代码默认值/后台「系统设置」接管,通常无需设置。
# 完整说明见 docs/deployment-multi-instance.md。取消注释并填写后生效:
#
# 全副本必须一致的三项(推荐显式设置,避免依赖 APP_SECRET 派生):
#JWT_SECRET=
#INTERNAL_TOKEN=
#REDIS_KEY_PREFIX=            # 如 prod:;网关与引擎必须同值
#
# compose 必填(compose 已 required,缺失会直接报错):
#REDIS_PASSWORD=
#POSTGRES_DSN=                # 外部 PostgreSQL(托管实例或 DBA 维护),例 postgresql://user:<pwd>@pg.example.com:5432/chiron0827
#S3_ENDPOINT_HOST=           # S3 兼容端点（**纯 host**，不带 scheme）：云厂商如 oss-cn-hangzhou.aliyuncs.com；自托管填 minio:9000
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#METRICS_TOKEN=              # Prometheus 抓取网关 /metrics 的共享 Bearer token(网关与 prometheus 同值)
#
# 多副本应用参数(有默认值,按需覆盖):
#PYTHON_ENGINE_ADDRESS=       # 引擎地址(批 E1 动态发现时的静态回退),如 http://python-engine:8000
#ALLOW_DIRECT_JWT=false # true 时允许持合法 JWT 绕过网关直连引擎(跳过限流与审计);生产保持 false
#ENGINE_ADVERTISE_URL=        # 引擎对外可达地址(批 E1,如 http://engine-0:8000);空=不注册,网关回退静态
#POSTGRES_MAX_CONN=20         # 网关 PG 连接池上限(旧名 POSTGRES_MAX_CONNS 仍被接受,但会打印弃用告警)
#DB_POOL_MAX_SIZE=20          # 引擎 PG 连接池上限(USE_UNIFIED_DB_CLIENT=false 时生效;true 则引擎经网关访问 DB)
#  ↑ 连接池容量约束(扩容必看):网关与引擎各自持有连接池、都连同一个 PostgreSQL,因此
#     N_网关×POSTGRES_MAX_CONN + M_引擎×DB_POOL_MAX_SIZE ≤ PG max_connections
#     默认值下 4 网关+4 引擎即接近默认的 100 连接上限。两侧启动日志都会打印
#     pool_max_conns / pg_max_connections / instances_supported,可按其核算。
#WORKER_ID=0                  # snowflake 实例 ID(0-1023)。**多副本必须每副本不同**:留空时先从
#                              主机名末尾数字推导(StatefulSet 的 chiron-0/1/2 天然唯一),推导不出
#                              就在 data 目录里随机生成并落盘 —— 多副本各自随机有撞号可能
#STORAGE_BACKEND=s3           # 网关的媒体对象存储;compose 默认 s3(云对象存储;自建 MinIO 需
#                              --profile selfhosted-s3),本机开发可 local
#MEDIA_STORE_BACKEND=s3       # 引擎的媒体后端。**必须与 STORAGE_BACKEND 同值**:引擎代码默认
#                              local,不设就是各副本各写本地盘、重启即丢、副本间互相看不见
#DOCS_ENABLED=false           # 是否暴露引擎 API 文档(/docs、/openapi.json)。默认关 —— 这几个
#                              路径在引擎中间件里免认证,端口被反向代理误暴露即公开 API 契约
#MCP_POOL_ENABLED=true        # 引擎副本增多后按需对部分副本设 false
#DEGRADED_MODE=false          # 默认 false=Redis 未配置/不可用时网关与引擎拒绝启动;仅单机开发设 true 才允许进程内降级
#
# ── Agent 预算（M20 起命名已分开，**不再有同名不同义**）──────────────────────
# 两类数、两个命名族，设值前先确认要调哪一类：
#   ① **单次 / 默认**（网关读）：单次 LLM 调用的输出上限、每次提交的默认回合数；
#   ② **run 全程**（引擎读）：一个 run 跨续跑累计的 token / 回合 / 步数 / 墙钟 / 成本上限。
#
# 历史教训：`AGENT_MAX_TOKENS` 曾是"网关的单次输出上限（8192）"与"引擎的 run 全程预算（400k）"
# **同一个名字**；共享 env 时按网关口径设 8192，引擎几乎每个 run 都以 `budget_exceeded:tokens`
# 收口，两侧还都没有校验。现在旧名**不再被任何一侧读取**，网关启动会直接拒绝
# （`config/agent_env_rename.go`，报错会点名每个旧名该换成哪个新名）。
#
# ① 网关侧（单次 / 默认；后台「系统设置」优先，env 只是部署默认）：
#AGENT_MAX_OUTPUT_TOKENS=8192   # 单次 LLM 调用的 max output tokens（**不是** run 预算）
#AGENT_DEFAULT_MAX_TURNS=5      # 每次提交的默认回合数；请求里的 llm_config.max_turns 优先
#
# ② 引擎侧（一个 run 全程；每轴 0 = 该轴不限，整条留空 = 用代码默认）：
# run 级上限跨**崩溃接管续跑**继承起点：起点读 agent_runs.checkpoint.usage 里由"花钱那一段"
# 每回合末整体覆写的全程累计 ⇒ 接管那一段不再白送一整份额度。
#AGENT_RUN_MAX_TOKENS=400000    # 单 run token 上限：只拦明显失控，正常长任务在数十万量级
#AGENT_RUN_MAX_TURNS=0          # 单 run 回合数上限；默认不限（每请求的回合数由 Agent Profile 给）
# 下面三轴**不带 RUN_**：它们只由引擎读，不与网关撞名，改名反而制造无谓的破坏性变更。
#AGENT_MAX_STEPS=60             # 单 run 工具调用次数上限（max_turns 限"轮"，一轮内可调很多次工具）
#AGENT_MAX_SECONDS=0            # 单 run 墙钟上限；默认不限（回合超时归网关管，引擎不重复限）
#AGENT_MAX_COST=0               # 单 run 成本上限；引擎不算钱（计价口径在网关侧），只报 limit
# 子 Agent 的 per-run 预算（同一套机制，prefix 换成 SUBAGENT，token 默认更紧）：
#SUBAGENT_RUN_MAX_TOKENS=200000 # 实测一个正常子 run 约 2k-20k token，200k 只兜底失控
#SUBAGENT_RUN_MAX_TURNS=0
#SUBAGENT_MAX_STEPS=0           # 子 Agent 默认不要步数轴：步数由 max_turns 与注册表看门狗管
#SUBAGENT_MAX_SECONDS=0         # 单 run 墙钟；真正的时长上限是看门狗 SUBAGENT_MAX_RUNTIME（默认 1800s）
#SUBAGENT_MAX_COST=0
# 任务线(同一 root run 派生的**全部委派与续跑**)的第二道闸门 —— 见 app/subagent/line_ledger.py。
# 为什么要它:per-run 预算管不住"一条任务线被反复续跑",每次续跑都是新 run、各自有一份额度。
# 账本单位是血缘闭包(root_run_id,迁移 0021):已发生量(PG 的 subagent_runs 用量按线求和)
# + 在途预留一起与上限比;耗尽则**暂停这条线**并挂出一张「提额」待办(复用 M7 收件箱),
# 有人提额后续跑。单条线可用 run_lineage_ledger.cap_tokens 覆盖(-1 = 这条线不限,0 = 跟随默认)。
#SUBAGENT_LINE_MAX_TOKENS=2000000   # 0 = 关掉整条线的闸门;取值参照"正常一线约 100-1000 个 run"
# 在途预留的重述(M18):派发时那份预留是 per-run 上限的**静态猜值**,同线其它 run 看不到这一段的
# 真实速度。开启后每个"带用量"的事件把那条预留换成**已花 + 观测速率×120s 的投影余量**
# (上限夹 per-run token 上限、下限不低于已花;没有样本就原样保留派发值,不编数)。
# 默认 shadow 的理由:重述把"确定上界"换成估计,一个花得比上限**慢**的 run 会让同线并发在途变多。
# 切换前先看的序列是 subagent_line_projection_tokens 的分布(shadow 阶段就在打点)。
#SUBAGENT_LINE_PROJECTION=shadow  # off(不算不写) / shadow(默认:算、打点、不写) / enforce(真的换掉那条预留)
#
# 换 key 重试（M23）：一次 LLM 请求遇到坏 key / 限流时，换一把 key 再试一次（用户无感），
# 而不是直接失败或走 provider 级降级（后者会让用户看到模型变了）。
# **只覆盖"还没向调用方产出任何东西"的那一次调用** —— 流式响应一旦开始吐 chunk 就绝不重试
# （否则重复输出 + 重复计费）。触发：401/403（key 失效）、429（该 key 限流）、5xx、以及
# 提交点前的连接/超时；400/422（请求本身错）**不**重试。观测 `llm_key_retry_total{outcome}`。
# 上限刻意低：重试会放大上游压力（LiteLLM 把 max_retries 钉成 0 正是为此）。
#KEY_RETRY_MAX=1               # 0 = 关掉整个机制；默认 1（最多换一把 key）
#
# 网关按-run 用量对账（M19）：崩溃 / 自动接管那一段**不经过网关**（引擎的
# _auto_resume_runner 直接构造 runtime），而网关只按终态 done 事件计费 ⇒ 那一段用量
# 永远不入账。对账 job 读引擎写的 agent_runs.checkpoint.usage（run 级权威账），扣掉
# 该 run 的回合在 turns / billing_records 里已计过的量，把差额补进用户余额 +
# billing_records + 租户额度池。旧快照（没有 turn_ids）、turn_ids 被截断、无网关回合的
# run 一律**跳过**（宁可少补，不能多收）。扣费幂等键含水位总量，重复对账不会重复扣。
# 默认 shadow：只算、打指标、不动账；切 enforce 前看
# run_usage_reconcile_shadowed / run_usage_reconcile_tokens（规模与方向）。
#RUN_USAGE_RECONCILE_MODE=shadow           # off(不跑) / shadow(默认:算、打点、不动账) / enforce(真补)
#RUN_USAGE_RECONCILE_INTERVAL_SECONDS=300  # 巡检间隔（秒）
#RUN_USAGE_RECONCILE_MIN_AGE_SECONDS=120   # 快照静置多久才参与（避免补"还在跑"的 run）
#RUN_USAGE_RECONCILE_MAX_AGE_DAYS=30       # 只对账这个窗口内的 run（与 turns 保留期一致）
#RUN_USAGE_RECONCILE_BATCH=50              # 单轮处理上限
#
# 独立沙箱执行（P0-1 根治）：把 agent 命令 / Python 代码的执行下沉到受限容器
# （docker-compose 的 sandbox-service：只读根 + cap_drop ALL + 无外网出口）。
# **默认已启用**（service）。引擎启动会探测服务健康：不可达且 DEGRADED_MODE=false
# ⇒ 拒绝启动；单机开发请设 SANDBOX_BACKEND=local，或 DEGRADED_MODE=true 允许回退。
#SANDBOX_BACKEND=service          # service(默认,下沉到独立容器) / local(进程内,仅单机开发)
#SANDBOX_SERVICE_URL=http://sandbox-service:8001
#SANDBOX_SERVICE_TENANTS=         # 逗号分隔租户白名单;空 = 全部租户走服务(默认)
#                                 # 填名单则只有名单内租户走服务(灰度/豁免);含 * 等价于空
#ALLOW_SCHEMA_DRIFT=false     # 启动时只读校验数据库 migration 版本(head vs alembic_version);不一致默认拒绝启动,true 放行
#
# 生命周期 hooks(引擎侧,批 G/G+;**全部默认关** —— 不开则零行为变化):
#HOOKS_ENABLED=false              # 机制总开关;false=不加载声明文件、不注册、不执行
#HOOKS_ALLOW_USER_DEFINED=false   # 是否允许**租户自定义** hook;SaaS 部署保持 false
#HOOKS_TIMEOUT_SECONDS=5          # 单个 hook 的硬超时(超时按失败处理但不阻断主流程)
#HOOKS_EVENT_BUDGET_SECONDS=10    # 一个事件上所有 hook 的累计预算(N 个 hook 不再线性拖慢)
#HOOKS_CONFIG_PATH=               # 部署级声明文件(hooks.json)路径;空=零行为变化
#HOOKS_ALLOW_COMMANDS=false       # `command` 形态(运维声明的本地命令)独立开关;默认关
#HOOKS_COMMAND_ALLOWLIST=         # 该形态允许的可执行文件(逗号分隔;裸名或绝对路径);空=一条也不批准
#HOOKS_ALLOW_WEBHOOKS=false       # `webhook` 形态(出站 POST 到运维声明的 URL)独立开关;默认关
#HOOKS_WEBHOOK_ALLOWLIST=         # 该形态允许的目标 host(逗号分隔;**只比 host 名**);空=一个也不批准
#HOOKS_ALLOW_CONTEXT_INJECTION=false # 是否把 hook 的结构化 `additional_context` 作为独立 system 消息注入(批次 4);默认关
#  ↑ `command` 形态是「不扩大可执行面」唯一登记在案的例外:租户不可达,命令走上面这张**部署自备**
#     的白名单(不复制面向模型的那张)。声明文件格式与纪律见 docs/hook-protocol-design.md §4.2/§4.3。
#
# 知识库（PageIndex）。两种 provider 二选一，用户在「知识库设置」页选择：
#   自托管：用下面配置的模型 + 共享索引目录自己建索引（仅 text-based PDF）
#   Cloud ：用户自带 PageIndex API key（支持 PDF/PPTX/Word 与扫描件 OCR，按页计费）
# 自托管的索引根目录。**必须在所有引擎副本可见的共享存储上**（NFS / RWX PVC / 挂载桶），
# 否则多实例下会出现"同一份文档时而能查、时而查不到"（local 模式没有中心服务，索引文件就是真相）。
#KNOWLEDGE_SELFHOSTED_ROOT=/srv/chiron/knowledge_index
# 自托管使用的模型（索引模型用基础档即可；问答模型越强检索越准）。端点与 key
# 复用既有的 provider 配置解析（后台「服务提供商」/ {PROVIDER}_BASE_URL / _API_KEY）。
#KNOWLEDGE_SELFHOSTED_INDEX_MODEL=
#KNOWLEDGE_SELFHOSTED_CHAT_MODEL=
# Cloud 模式的问答模型（索引与存储在 PageIndex Cloud，只有"在树上推理"这一步用我们的模型）
#KNOWLEDGE_CLOUD_CHAT_MODEL=
# 原文对象存储（默认跟随 MEDIA_STORE_BACKEND；生产建议 s3，local 时必须挂共享卷）
#KNOWLEDGE_BLOB_BACKEND=
#KNOWLEDGE_LOCAL_PATH=/srv/chiron/knowledge
#KNOWLEDGE_S3_BUCKET=
#KNOWLEDGE_S3_PREFIX=knowledge/
# 知识库服务（S4：PageIndex 跑在独立镜像里，引擎经内网 HTTP 调它）。
# 未配 KNOWLEDGE_SERVICE_URL 时知识库显示"未启用"（不阻塞启动）。
#KNOWLEDGE_SERVICE_URL=http://pageindex-search:8100
#KNOWLEDGE_SERVICE_TIMEOUT=120
# 索引侧独立的 LLM 连接（留空 = 交给 litellm 读它的标准环境变量如 OPENAI_API_KEY）：
#KNOWLEDGE_SELFHOSTED_LLM_BASE_URL=
#KNOWLEDGE_SELFHOSTED_LLM_API_KEY=
#KNOWLEDGE_SELFHOSTED_OPTIMIZE=full
#PAGEINDEX_WORKER_CONCURRENCY=2      # 索引 worker 并发（跨库并发、同库串行）
#PAGEINDEX_MAX_CONCURRENCY=4         # 检索服务并发上限（chat 是同步重活）
#  未配自托管时服务照常启动，该 provider 显示"未启用"；用户仍可选 Cloud 并自带 key。
#
# 模型密钥(compose 引擎透传;亦可在后台「系统设置」维护后下发):
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#LLM_API_KEY=

