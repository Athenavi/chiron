{
  "name": "frontend-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:ui && vue-tsc -b && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:ui": "node scripts/check-z-index-tokens.mjs && node scripts/check-theme-token-contract.mjs && node scripts/check-motion-tokens.mjs && node scripts/check-i18n.mjs && node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@file-viewer/preset-all": "^2.2.9",
    "@file-viewer/vue3": "^2.2.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/vue-virtual": "^3.13.35",
    "@types/markdown-it": "^14.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "vue": "^3.5.39",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@file-viewer/vite-plugin": "^2.2.9",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.20.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.1",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
