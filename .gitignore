# ── Go ──
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
go.work
build/

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Node / Vue ──
node_modules/
.next/
out/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── Environments ──
.env
# .env 的备份/变体同样含密钥。APP_SECRET 是唯一根密钥（派生 JWT_SECRET /
# INTERNAL_TOKEN 与配置加密密钥），一个 `git add -A` 提交进去 = 全盘失守。
# 用 `.env*` 而非 `.env.*`：后者不匹配无点号的变体（如 .env2 / .envbak），
# 曾导致一份与 .env 内容完全相同的密钥副本以未跟踪状态长期留在工作区。
.env*
!.env.example
*.bak
# compose 本机覆盖文件（端口避让等，本机专用）：不入库，各环境按需自建。
# 曾因被提交而让**所有人**的 `docker compose up` 都用本机端口（前端 8081 / redis 16379），
# 与 README 和 docs/deployment-multi-instance.md 写的 :3000 不一致 —— 而文件自己的
# 注释就写着"不要提交到仓库（本机专用）"。`git rm --cached` 后本机文件仍在，行为不变。
docker-compose.override.yml
.envrc
.venv
env/
venv/
ENV/

# ── Runtime data ──
workspace/
# CHIRON_DATA_DIR：运行时数据（媒体、技能缓存、worker.id 等），全部是实例本地产物
data/
backend/
*.db
*.sqlite*
*.rdb
*.pid
.pids/
logs/
*.jsonl
# snowflake worker ID（internal/id/snowflake.go 的 resolveWorkerID 落盘）：
# 每实例本地运行产物，入库会在多副本部署时把同一个 worker ID 复制给所有副本。
worker.id

# ── Reasonix / local tooling ──
.reasonix/
.agents/
.workbuddy/
reasonix.toml
.cowork-temp/
**/.cowork-temp/

# ── Test data ──
test_register.json
*.log
stderr.log
stdout.log

# ── Misc ──
third_party/
sandbox/
/plugins.json
/frontend-vue/public/vendor/

# @file-viewer 插件每次构建都会重写该清单（含本机绝对路径与时间戳），不入库
/frontend-vue/public/flyfish-viewer-assets.json

# 仓库根的 vendor/：放的是**本地参考**（第三方源码仓库 DeepSeek-Reasonix / ZCode / dsh-synapse，
# 以及外部服务的 API 文档如「晴辰云邮」的 mail.md）。它们不参与构建、也不随仓库分发，
# 因此整体忽略 —— 此前它们长期以未跟踪状态噪声化 `git status`，而 mail.md 又被单独特例暂存，
# 定位含混。需要共享其中内容时，请把**提炼后的结论**写进 docs/，而不是把原文搬进仓库。
/vendor/

# ── 第三方参考源码 ──
# 这里原先逐文件列出了 /third/DeepSeek-Reasonix-main-v2/ 的 6604 个路径
# （该目录已不在工作区），使本文件膨胀到 6677 行 / 504KB。
# 改为目录级忽略：语义等价，新增文件无需再逐条登记。
/third/

# 数据库凭据（本地明文，仅用于交接记录，禁止入库）
.pg-credentials.txt

# ── 公开仓库的凭据兜底（与语言无关）──
# 上面各节按生态分类；这一节兜住**凭据/私钥形态**。社区化之后贡献者会带来自己的本机文件，
# 这些形态一旦入库就是全盘失守。
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.keystore
*.jks
# PgBouncer 的 userlist 含角色凭据（deploy/pgbouncer/.gitignore 已局部覆盖，这里兜底）
userlist.txt
# 编辑器 / 系统垃圾
.DS_Store
Thumbs.db
*.orig
*.rej

# ── 桌面端组件构建产物 ──
# `desktop-local/scripts/build_component.py` 产出的真实组件包（bundle.zip 是
# 带整棵依赖树的归档，几百 MB，不能入库）。产物是构建出来的，不是源码。
/desktop-local/dist/
# 随安装包发布的 Python 运行时（`desktop-local/scripts/prepare_python_runtime.py` 生成，
# 约 140MB，含解释器与 desktop-local 的全部依赖）。产物，不入库；
# `electron-builder.yml` 把它映射成 `resources/python/`。
/frontend-vue/python-runtime/
# 内置 redis 二进制（`desktop-local/scripts/prepare_redis.py` 就位；`*.exe` 已被上面
# Go 段忽略，这里整目录忽略，避免 .conf/.dll 漏网）
/desktop-local/bin/
# 构建脚本的临时探针目录（本地排查用）
/.probe/
